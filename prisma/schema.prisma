datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Event {
  id          Int      @id @default(autoincrement())
  type        String
  message     String?
  sessionId   String?
  timestamp   DateTime @default(now())
  ip          String?
  userAgent   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  metadata    Json?
}

model UserSession {
  sessionId   String   @id
  createdAt   DateTime @default(now())
  lastSeen    DateTime @default(now())
  userAgent   String?
  ip          String?
  utmSource   String?
  utmCampaign String?
}

model Payment {
  id             Int      @id @default(autoincrement())
  stripeSessionId String?
  amount         Int?
  currency       String?
  email          String?
  personA        String?
  personB        String?
  createdAt      DateTime @default(now())
  sessionId      String?
}

model MetricsCache {
  key       String   @id
  value     Json?
  updatedAt DateTime @default(now())
}
